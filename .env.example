# Copy to .env.local and fill in. Every variable here must also be declared in
# src/env.ts — anything undeclared is invisible to the app.

# Public base URL of this deployment (used for metadata, sitemap, OG images).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" only in build environments that have no real secrets (Docker
# image builds, CI type-checks). Never set it at runtime.
# SKIP_ENV_VALIDATION="false"

# --- Added as the stack is chosen ---
# DATABASE_URL="postgresql://user:password@localhost:5432/vyral"
# AUTH_SECRET=""
